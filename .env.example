# Model provider follows the keys: Anthropic (Claude Sonnet 5.5) when ANTHROPIC_API_KEY is set,
# otherwise OpenRouter (GLM 5.3, z-ai/glm-5.3). Set at least one.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides. Leave empty for the defaults above; an override must belong to the
# provider the keys select (Anthropic ids like claude-sonnet-5-5, OpenRouter ids like z-ai/glm-5.3).
CULPRIT_MODEL=
VICTIM_MODEL=

# neatlogs ingest (project key, not the nlw_ key). Without it, tracing is off.
NEATLOGS_API_KEY=

# Where the RefundDesk clone lives, if not ../refunddesk
CULPRIT_VICTIM_REPO=
